# Absolute site URL used for canonical links, Open Graph tags, sitemap and robots.
# Set this before building for production, e.g. https://bontudereje.com
NEXT_PUBLIC_SITE_URL=

# Optional: hosted contact form endpoint (https://formspree.io).
# Without it, the contact form falls back to opening the visitor's email client.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
